{
    "name": "arpamail-website",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "bun run build && wrangler dev",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "deploy": "bun run build && wrangler deploy --strict",
        "cf-typegen": "wrangler types ./src/worker-configuration.d.ts -c wrangler.toml -c ../relay/wrangler.toml"
    },
    "devDependencies": {
        "@sveltejs/adapter-cloudflare": "^7.2.8",
        "@sveltejs/kit": "^2.53.4",
        "@sveltejs/vite-plugin-svelte": "^6.2.4",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/typography": "^0.5.19",
        "@tailwindcss/vite": "^4.2.1",
        "@types/node": "^25.3.3",
        "svelte": "^5.53.6",
        "svelte-check": "^4.4.4",
        "svelte-turnstile": "^0.11.0",
        "tailwindcss": "^4.2.1",
        "typescript": "^5.9.3",
        "vite": "^7.3.1",
        "wrangler": "^4.69.0"
    }
}
